    "/api/rank": {
      "get": {
        "operationId": "get_rank_api_rank_get",
        "parameters": [
          {
            "in": "query",
            "name": "professions",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "title": "Professions",
              "type": "array"
            }
          },
          {
            "description": "copper",
            "in": "query",
            "name": "min_profit",
            "required": false,
            "schema": {
              "default": 0,
              "description": "copper",
              "title": "Min Profit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "top",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 500,
              "minimum": 1,
              "title": "Top",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
